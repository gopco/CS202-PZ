<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" maxWidth="Infinity" maxHeight="Infinity" hgap="8" vgap="8"
          fx:controller="rs.ac.metropolitan.project.AgencyController">
    <padding>
        <Insets topRightBottomLeft="8"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS"/>
        <RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>
    <TableView fx:id="hotelTable" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <columns>
            <TableColumn text="Name" fx:id="nameColumn" prefWidth="100"/>
            <TableColumn text="Address" fx:id="addressColumn" prefWidth="200"/>
            <TableColumn text="Contact Information" fx:id="contactInformationColumn" prefWidth="200"/>
            <TableColumn text="Number of Rooms" fx:id="numberOfRoomsColumn" prefWidth="100"/>
            <TableColumn text="Price" fx:id="priceColumn" prefWidth="100"/>
            <TableColumn text="Rating" fx:id="ratingColumn" prefWidth="100"/>
        </columns>
    </TableView>
    <GridPane GridPane.columnIndex="1" GridPane.rowIndex="0" hgap="8" vgap="8">
        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Contact Information:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="contactInformationField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Number of Rooms:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="numberOfRoomsField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Rating:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="ratingField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <ButtonBar GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6">
            <buttons>
                <Button text="New" ButtonBar.buttonData="LEFT" onAction="#onNewHotel"/>
                <Button text="Save" ButtonBar.buttonData="LEFT" onAction="#onSaveHotel"/>
                <Button text="Delete" ButtonBar.buttonData="RIGHT" onAction="#onDeleteHotel"/>
            </buttons>
        </ButtonBar>
    </GridPane>
    <TableView fx:id="reservationTable" GridPane.columnIndex="0" GridPane.rowIndex="1">
        <columns>
            <TableColumn text="Start Date" fx:id="startDateColumn" prefWidth="100"/>
            <TableColumn text="End Date" fx:id="endDateColumn" prefWidth="100"/>
            <TableColumn text="Number of Rooms" fx:id="reservationNumberOfRoomsColumn" prefWidth="100"/>
            <TableColumn text="Contact Information" fx:id="reservationContactInformationColumn" prefWidth="200"/>
        </columns>
    </TableView>
    <GridPane GridPane.columnIndex="1" GridPane.rowIndex="1" hgap="8" vgap="8">
        <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="startDateField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="endDateField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Number of Rooms:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="reservationNumberOfRoomsField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Contact Information:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="reservationContactInformationField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <ButtonBar GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <buttons>
                <Button text="New" ButtonBar.buttonData="LEFT" onAction="#onNewReservation"/>
                <Button text="Save" ButtonBar.buttonData="LEFT" onAction="#onSaveReservation"/>
                <Button text="Delete" ButtonBar.buttonData="RIGHT" onAction="#onDeleteReservation"/>
            </buttons>
        </ButtonBar>
    </GridPane>
    <Label fx:id="weatherInfoLabel" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2"/>
</GridPane>
